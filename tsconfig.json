{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@config/*": ["./src/config/*"],
      "@clients/*": ["./src/clients/*"],
      "@services/*": ["./src/services/*"],
      "@models/*": ["./src/models/*"],
      "@builders/*": ["./src/builders/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src", "tests", "playwright.config.ts"]
}